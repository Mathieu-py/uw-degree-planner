{
  "name": "uw-elective-finder",
  "version": "0.1.0",
  "description": "Browse and filter UWaterloo elective courses by usefulness, easiness, prerequisites, and available seats, using UWFlow ratings.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze --output",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "fetch-courses": "tsx scripts/build-catalog.ts",
    "refresh-seats": "tsx scripts/build-catalog.ts --seats-only",
    "scrape-programs": "tsx scripts/scrape-programs.ts",
    "build-program-index": "tsx scripts/build-program-index.ts",
    "check-subjects": "tsx scripts/diagnostic/check-subjects.ts",
    "guard-snapshot": "tsx scripts/guard-snapshot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "next": "16.2.11",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.61.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  }
}
