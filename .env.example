# Copy to `.env.local`. Both vars are required (see lib/supabase/env.ts).
# Get them from `pnpm exec supabase status` (local) or the Supabase dashboard
# → Project Settings → API (remote). The anon key is browser-safe; never put
# the service-role key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: UW Open Data seat counts for `pnpm fetch-courses` (scripts only,
# never read by the app). Without it a refresh keeps last-known seating.
UW_OPENDATA_KEY=

# Canonical origin for metadata/robots/sitemap; set on the prod deploy.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Sentry error reporting. Leave unset locally — the SDK no-ops.
# SENTRY_AUTH_TOKEN additionally enables readable stacks (source-map upload).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
